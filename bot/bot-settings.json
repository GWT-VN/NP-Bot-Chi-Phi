{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "mcp__plugin_discord_discord__reply",
      "mcp__plugin_discord_discord__react",
      "mcp__plugin_discord_discord__fetch_messages",
      "mcp__plugin_discord_discord__download_attachment",
      "mcp__npso__kiem_tin",
      "mcp__npso__ghi_khoan",
      "mcp__npso__sua_khoan",
      "mcp__npso__doc_so",
      "mcp__npso__tin_chua_xu_ly",
      "Read(//Users/*/.claude/channels/discord-np/inbox/**)"
    ],
    "deny": [
      "mcp__plugin_discord_discord__edit_message",
      "WebFetch",
      "WebSearch",
      "Bash",
      "PowerShell",
      "Edit",
      "Write",
      "NotebookEdit",
      "Agent",
      "Skill",
      "Workflow",
      "Artifact",
      "SendUserFile",
      "CronCreate",
      "RemoteTrigger",
      "Glob",
      "Grep",
      "Read(**/.env*)",
      "Read(**/token.json)",
      "Read(**/credentials.json)",
      "Read(//Users/*/Bots/.secrets/**)",
      "Read(//Users/*/.ssh/**)",
      "Read(//Users/*/.claude/channels/discord/**)",
      "Read(//Users/*/.claude/channels/discord-admin/**)",
      "Read(//Users/*/.claude/.credentials.json)",
      "Read(//Users/*/Bots/gwt-discord-bot/**)",
      "mcp__shopee",
      "mcp__bap",
      "mcp__codegraph",
      "mcp__claude-in-chrome",
      "mcp__terminal",
      "mcp__computer-use",
      "mcp__scheduled-tasks",
      "mcp__plugin_small-business_gmail",
      "mcp__plugin_small-business_google-drive"
    ]
  },
  "enabledPlugins": {
    "discord@claude-plugins-official": true,
    "superpowers@claude-plugins-official": false,
    "file-to-markdown@gwt-global-registry": false,
    "mattpocock-skills@claude-plugins-official": false,
    "supabase-ddl-guard@gwt-global-registry": false,
    "frontend-design@claude-plugins-official": false,
    "figma@claude-plugins-official": false,
    "nateherk-design@nateherk": false,
    "ponytail@ponytail": false,
    "prompts.chat@prompts.chat": false
  },
  "syncClaudeAiPlugins": false,
  "syncClaudeAiSkills": false,
  "deniedMcpServers": [
    {
      "serverName": "codegraph"
    },
    {
      "serverName": "ui-skills"
    },
    {
      "serverName": "mobbin"
    },
    {
      "serverName": "higgsfield"
    },
    {
      "serverName": "descript"
    },
    {
      "serverName": "apify"
    },
    {
      "serverName": "davinci-resolve"
    }
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_discord_discord__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/hooks/chan-discord.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/hooks/nhat-ky.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/hooks/nhat-ky.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
